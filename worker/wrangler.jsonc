{
  "name": "dream-junkies-talk",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../cinema",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TALK", "class_name": "TalkRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TalkRoom"] }
  ]
}
